APP_NAME=Multi-School Thesis Repository Cloud API
ENV=development
API_PREFIX=/api
SECRET_KEY=replace_with_a_long_random_64_character_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/murrs
ALLOWED_EMAIL_DOMAINS=gimpa.edu.gh

# Multi-Tenant SaaS & Cloud Routing
DEFAULT_TENANT_SLUG=gimpa
PUBLIC_FRONTEND_URL=http://localhost:5173
# Optional root domain for institution subdomains (e.g. gimpa.thesis.example.com)
PLATFORM_BASE_DOMAIN=
AUTO_APPROVE_INSTITUTIONS=false
MAX_LOGO_SIZE_BYTES=2097152
CORS_ALLOW_ORIGINS=

# Platform Operator Bootstrap Account (set strong password in production)
PLATFORM_ADMIN_EMAIL=platform-admin@thesiscloud.org
PLATFORM_ADMIN_PASSWORD=

# Private File Storage ("local" for tenant-partitioned disk or "s3" for cloud object storage)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=tenants

# Transactional SMTP Email Service
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Multi-School Thesis Repository
SMTP_TIMEOUT_SECONDS=30
SMTP_MAX_RETRIES=3
SMTP_RETRY_BACKOFF_SECONDS=1.5

# OnlyOffice integration (tenant-scoped HMAC signed file fetch & save callbacks)
ONLYOFFICE_DOC_SERVER_URL=
PUBLIC_API_BASE_URL=http://127.0.0.1:8011
ONLYOFFICE_CALLBACK_BASE_URL=
